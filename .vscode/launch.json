{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET API (Server)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-server",
      "program": "${workspaceFolder}/server/ProjectHub.Api/bin/Debug/net10.0/ProjectHub.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/server/ProjectHub.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Flutter (Client)",
      "type": "dart",
      "request": "launch",
      "cwd": "client",
      "program": "lib/main.dart"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Server + Client)",
      "configurations": [
        ".NET API (Server)",
        "Flutter (Client)"
      ],
      "stopAll": true
    }
  ]
}

