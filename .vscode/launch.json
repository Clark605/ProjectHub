{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET API (Server)",
      "type": "dotnet",
      "request": "launch",
      "preLaunchTask": "prepare-and-build-server",
      "projectPath": "${workspaceFolder}/server/ProjectHub.Api/ProjectHub.Api.csproj",
      "launchSettingsProfile": "https",
      "serverReadyAction": {
        "action": "openIntegratedBrowser",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Flutter (Client)",
      "type": "dart",
      "request": "launch",
      "cwd": "client",
      "program": "lib/main.dart"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Server + Client)",
      "configurations": [
        ".NET API (Server)",
        "Flutter (Client)"
      ],
      "stopAll": true
    }
  ]
}

